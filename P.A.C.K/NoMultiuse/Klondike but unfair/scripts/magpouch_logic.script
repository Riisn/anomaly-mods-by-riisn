--========================================================
--  Mag Pouch Belt Logic Script for STALKER G.A.M.M.A.
--  Author: Riisn
--  Purpose: Prevents equipping multiple mag pouches at once
--========================================================

-- Define non-stackable belt items (your mag pouches)
local magpouch_sections = {
    ["af_magpouch_m1_up2"] = true,
    ["af_magpouch_m2_up2"] = true,
    ["af_magpouch_l"] = true,
    ["af_magpouch_l_up"] = true,
    ["af_magpouch_l_up2"] = true,
    ["af_magpouch_med"] = true,
    ["af_magpouch_med_up"] = true,
    ["af_magpouch_med_up2"] = true,
    ["af_magpouch_cw"] = true,
    ["af_magpouch_cw_up"] = true,
    ["af_magpouch_cw_up2"] = true,
    ["af_magpouch_anvel"] = true,
}


-- Helper: check for duplicates on belt
local function check_magpouch_duplicate(slot_item)
    local section = slot_item:section()
    if not magpouch_sections[section] then return end  -- only check mag pouches

    local count = 0
    db.actor:iterate_belt(function(owner, obj)
        if obj:section() == section then
            count = count + 1
        end
    end)

    if count > 1 then
        printf("[MagPouch AntiDupe] Duplicate detected: %s. Removing new item.", section)
        db.actor:move_to_ruck(slot_item)
    end
end

-- Register the callback so it runs when items are equipped
function on_game_start()
    RegisterScriptCallback("actor_item_to_belt", check_magpouch_duplicate)
end
