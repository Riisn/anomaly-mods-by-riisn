<?xml version="1.0" encoding="utf-8"?>
<string_table>
    <string id="encyclopedia__notes_eqz_pickpocket_tracker">
        <text>Pickpocketing</text>
    </string>
    <string id="encyclopedia__notes_eqz_pickpocket_tracker_text">
        <text>\n\n\n\nWelcome to %c[0,242,86,11]Riisn's%c[ui_gray_2] Pickpocketing!\n</text>
    </string>
	<string id="ui_mcm_menu_pickpocket">
        <text>%c[0,242,86,11]Riisn's \nPickpocketing</text>
    </string>
    <string id="ui_mcm_pickpocket_title">
        <text>Riisn's Pickpocketing Settings</text>
    </string>
	<string id="ui_mcm_pickpocket_trigger_key">
        <text>Keybind Starting The Minigame</text>
    </string>
	<string id="ui_mcm_pickpocket_confirm_key">
        <text>Keybind Confirming The Theft</text>
    </string>
	<string id="ui_mcm_pickpocket_allow_enemies">
        <text>Allow Enemies To Be Pickpocketed</text>
    </string>
	<string id="ui_mcm_pickpocket_allow_enemies_desc">
        <text>If enabled, enemies will be pickpocketable and will turn aware and hostile when failing the minigame. No goodiwll will be lost. If succeeded, the enemy will be left unaware, unless provoked by player in regular means.</text>
    </string>
	<string id="ui_mcm_pickpocket_zone_size">
        <text>The Size Of The Green Zone (Base Payout)</text>
    </string>
	<string id="ui_mcm_pickpocket_sweet_size">
        <text>The Size Of The Sweet Spot (Multiplier)</text>
    </string>
	<string id="ui_mcm_pickpocket_sweet_size_desc">
        <text>This is included in the Green Zone. For the sake of the stability of the mod and no crashes or corrupted files, do not set it larger than the Green Zone. :)</text>
    </string>
	    <string id="ui_mcm_pickpocket_loot_chance">
        <text>Sweet Spot Extra Loot Chance</text>
    </string>
	<string id="ui_mcm_pickpocket_loot_chance_desc">
        <text>The percent chance of getting extra loot while scoring the Sweet Spot payout. Rewards range from extremely common bolts and walkie talkies to ultra rare Toolkits.</text>
    </string>
    <string id="ui_mcm_pickpocket_needle_speed">
        <text>Minigame Needle Speed</text>
    </string>
    <string id="ui_mcm_pickpocket_cash_min">
        <text>Min Stolen Roubles</text>
    </string>
    <string id="ui_mcm_pickpocket_cash_max">
        <text>Max Stolen Roubles</text>
    </string>
    <string id="ui_mcm_pickpocket_sweet_spot_mult">
        <text>Sweet Spot Multiplier</text>
    </string>
    <string id="ui_mcm_pickpocket_base_goodwill_penalty">
        <text>Base Goodwill Penalty</text>
    </string>
    <string id="ui_mcm_pickpocket_fail_window_sec">
        <text>Strike Decay Cooldown (Game Seconds)</text>
    </string>
	<string id="ui_mcm_pickpocket_box_y">
        <text>Minigame UI Screen Position</text>
    </string>
    <string id="pickpocket_box_y_lst_ui_mcm_pickpocket_pos_center">
        <text>Center</text>
    </string>
    <string id="pickpocket_box_y_lst_ui_mcm_pickpocket_pos_lower">
        <text>Lower (Bottom Half)</text>
    </string>
	<string id="ui_mcm_pickpocket_icon_alpha">
        <text>Pickpocket Icon Opacity Controller</text>
    </string>
	<string id="ui_mcm_pickpocket_icon_alpha_desc">
        <text>Allows you to change max opacity for the icon that pops-up while crouching or holding LALT. 0% - invisible / 100% - fully visible.</text>
    </string>
	<string id="ui_mcm_pickpocket_icon_size">
        <text>Icon Size (in pixels)</text>
    </string>
	<string id="ui_mcm_pickpocket_time_factor">
		<text>Minigame Timescale (Slow Motion)</text>
	</string>
	<string id="ui_mcm_pickpocket_time_factor_desc">
		<text>Percentage of the game world speed while pickpocketing. Example: 0.05 - Game running on 5% speed during the minigame.</text>
	</string>
	<string id="ui_mcm_pickpocket_needle_speed_desc">
		<text>This dictates the speed of the minigame. Bigger the value, the faster and harder it gets.</text>
	</string>
	<string id="ui_mcm_pickpocket_fail_window_sec_desc">
		<text>The time it takes for a failure stack to go away in in-game seconds. Stalker Anomaly/GAMMA follows 1:6 scale. 30 minutes in-game = 5 minutes IRL. Decreases 1 per the time chosen.</text>
	</string>
	<string id="ui_mcm_pickpocket_base_goodwill_penalty_desc">
		<text>How much Goodwill will be lost upon first failure. This amount will double each consequent failure stack. Example: -20 > -40 > -80 > -160.</text>
	</string>
</string_table>