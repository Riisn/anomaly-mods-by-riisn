-------------------------------------------------------------------
-- Select a random item from the weighted loot categories
-------------------------------------------------------------------

local function get_random_pickpocket_loot()

    local total_weight = 0

    for _, category in ipairs(pickpocket_loot) do
        total_weight = total_weight + category.weight
    end

    local roll = math.random() * total_weight
    local accumulated = 0

    for _, category in ipairs(pickpocket_loot) do
        accumulated =
            accumulated + category.weight

        if roll <= accumulated then

            if #category.items == 0 then
                return nil
            end

            local item =
                category.items[
                    math.random(
                        1,
                        #category.items
                    )
                ]

            return item, category.name
        end
    end

    return nil
end

-------------------------------------------------------------------
-- MCM Config Retrieval Helper & Key Translator
-------------------------------------------------------------------

local function get_config(key)
    if ui_mcm and ui_mcm.get then
        local val = ui_mcm.get("pickpocket/" .. key)

        if val ~= nil then
            return val
        end
    end

    local fallback_defaults = {
        trigger_key           = DIK_keys.DIK_V,
        confirm_key           = DIK_keys.DIK_SPACE,
        allow_enemies         = false,
        needle_speed          = 0.25,
        time_factor           = 0.2,
        base_goodwill_penalty = -20,
        fail_window_sec       = 1800,
        cash_min              = 150,
        cash_max              = 500,
        zone_size             = 30,
        sweet_size            = 10,
        sweet_spot_mult       = 3.0,
        box_y                 = 250
    }

    return fallback_defaults[key]
end

local function mcm_key_to_dik(key_setting, default_dik)
    local raw_val = get_config(key_setting)

    if type(raw_val) == "number" and raw_val > 0 then
        return raw_val
    end

    return default_dik
end

-------------------------------------------------------------------
-- Pickpocket HUD Integration
--
-- Called by mod_pickpocket_hud.script.
--
-- Keep the actual pickpocket state private. The HUD only gets
-- this read-only question answered.
-------------------------------------------------------------------

function can_show_pickpocket_marker(npc)

    if not npc then
        return false
    end

    if not npc:alive() then
        return false
    end

    if not IsStalker(npc) then
        return false
    end

    ---------------------------------------------------------------
    -- Already searched?
    ---------------------------------------------------------------

    local npc_id =
        npc:id()

    if pickpocketed_npcs[npc_id] then
        return false
    end

    ---------------------------------------------------------------
    -- Hostile faction setting
    ---------------------------------------------------------------

    local raw_enemies =
        get_config("allow_enemies")

    local allow_enemies = false

    if raw_enemies == true
        or raw_enemies == 1
        or raw_enemies == "true"
        or raw_enemies == "1" then

        allow_enemies = true

    end

    ---------------------------------------------------------------
    -- Don't show hostile markers when hostile pickpocketing
    -- is disabled.
    ---------------------------------------------------------------

    if not allow_enemies
        and is_npc_hostile(npc) then

        return false

    end

    return true

end

-------------------------------------------------------------------
-- Failure Tracker Configuration
-------------------------------------------------------------------

local fail_timestamps = {}

-------------------------------------------------------------------
-- Core Helpers
-------------------------------------------------------------------

local function GetARGB(a, r, g, b)
    return (a * 16777216) + (r * 65536) + (g * 256) + b
end

local function get_current_game_seconds()
    local gtime = game.get_game_time()
    local Y, M, D, h, m, s, ms = gtime:get()

    return (Y * 31536000) +
           (M * 2592000) +
           (D * 86400) +
           (h * 3600) +
           (m * 60) +
           s
end

local function is_actor_walking()
    if not db.actor then return false end

    local is_slow_state = IsMoveState("mcAccel") or IsMoveState("mcCrouch")
    local no_ui_open = (main_input_receiver == nil or main_input_receiver() == nil)

    local alt_pressed = no_ui_open and (
        key_state(DIK_keys.DIK_LALT) ~= 0 or
        key_state(DIK_keys.DIK_RALT) ~= 0 or
        key_state(DIK_keys.DIK_LMENU) ~= 0 or
        key_state(DIK_keys.DIK_LSHIFT) ~= 0
    )

    return is_slow_state or alt_pressed
end

local function get_pickpocket_distance(npc)

    if not (npc and db.actor) then
        return nil
    end

    local actor_pos =
        db.actor:position()

    local npc_pos =
        npc:position()

    local dx =
        actor_pos.x - npc_pos.x

    local dy =
        actor_pos.y - npc_pos.y

    local dz =
        actor_pos.z - npc_pos.z

    local distance_sqr =
        (dx * dx) +
        (dy * dy) +
        (dz * dz)

    return math.sqrt(distance_sqr)

end

local function is_behind_npc(npc)
    if not (npc and db.actor) then return false end

    local pos_diff = db.actor:position():sub(npc:position())
    pos_diff.y = 0

    local dir_to_player = pos_diff:normalize()

    local npc_dir = npc:direction()
    npc_dir.y = 0
    npc_dir = npc_dir:normalize()

    local dot = (npc_dir.x * dir_to_player.x) +
                (npc_dir.z * dir_to_player.z)

    return dot < -0.3
end

local function is_target_in_pickpocket_range(npc)

    if not (npc and db.actor) then
        return false
    end

    local actor_pos =
        db.actor:position()

    local npc_pos =
        npc:position()

    local dx =
        actor_pos.x - npc_pos.x

    local dy =
        actor_pos.y - npc_pos.y

    local dz =
        actor_pos.z - npc_pos.z

    local distance_sqr =
        (dx * dx) +
        (dy * dy) +
        (dz * dz)

    return distance_sqr <=
        (PICKPOCKET_DISTANCE * PICKPOCKET_DISTANCE)

end

-------------------------------------------------------------------
-- Hostility Check
-- Uses the same direct relation check as the original working script.
-------------------------------------------------------------------

local function is_npc_hostile(npc)
    if not (npc and db.actor) then return false end

    return npc:relation(db.actor) == game_object.enemy
end

local function get_stash_cash_amount(npc)
    local raw_rank = npc:character_rank() or 0

    local c_min = tonumber(get_config("cash_min")) or 150
    local c_max = tonumber(get_config("cash_max")) or 500

    if c_max <= c_min then
        c_max = c_min + 100
    end

    local cash = math.random(c_min, c_max)

    if raw_rank > 8000 then
        cash = cash + math.random(500, 1500)
    elseif raw_rank > 4000 then
        cash = cash + math.random(250, 750)
    end

    return cash
end

-------------------------------------------------------------------
-- Dynamic Failure Tracker Export (Sequential 1-by-1 Decay)
-------------------------------------------------------------------

local function update_and_clean_strikes()
    local now_sec = get_current_game_seconds()
    local fail_window = tonumber(get_config("fail_window_sec")) or 1800

    while #fail_timestamps > 0 do
        local oldest_ts = fail_timestamps[1]

        if (now_sec - oldest_ts) > fail_window then
            table.remove(fail_timestamps, 1)

            if #fail_timestamps > 0 then
                fail_timestamps[1] = now_sec
            end
        else
            break
        end
    end
end

function get_tracker_info()
    local now_sec = get_current_game_seconds()
    local base_penalty = tonumber(get_config("base_goodwill_penalty")) or -20
    local fail_window = tonumber(get_config("fail_window_sec")) or 1800

    update_and_clean_strikes()

    local strikes = #fail_timestamps
    local next_penalty = base_penalty * math.pow(2, (strikes + 1) - 1)

    local time_remaining = 0

    if strikes > 0 then
        local oldest_ts = fail_timestamps[1]

        time_remaining = math.max(
            0,
            fail_window - (now_sec - oldest_ts)
        )
    end

    return strikes, next_penalty, time_remaining
end

-------------------------------------------------------------------
-- Escalating Failure Handler
-------------------------------------------------------------------

local function handle_failure(target)
    if not (target and target:alive()) then return end

    local npc_id = target:id()

    ----------------------------------------------------------------
    -- Determine whether hostile pickpocketing is enabled
    ----------------------------------------------------------------

    local allow_enemies = false
    local raw_enemies = get_config("allow_enemies")

    if raw_enemies == true
        or raw_enemies == 1
        or raw_enemies == "true"
        or raw_enemies == "1" then

        allow_enemies = true
    end

    local is_hostile_target =
        target:relation(db.actor) == game_object.enemy

    ----------------------------------------------------------------
    -- Hostile target: alert them with a tiny hit.
    -- No goodwill/reputation penalty is applied.
    ----------------------------------------------------------------

    if allow_enemies and is_hostile_target then

        local h = hit()

        h.draftsman = db.actor

        h.direction =
            target:position():sub(
                db.actor:position()
            ):normalize()

        h:bone("bip01_spine")

        h.power = 0.01
        h.impulse = 0
        h.type = hit.wound

        target:hit(h)
    end

    ----------------------------------------------------------------
    -- Failure tracking
    ----------------------------------------------------------------

    local npc_name =
        target:character_name() or "Stalker"

    local community =
        (target.character_community and target:character_community())
        or "stalker"

    local actor_name =
        (db.actor and db.actor:character_name())
        or "stalker"

    local now_sec =
        get_current_game_seconds()

    local base_penalty =
        tonumber(
            get_config("base_goodwill_penalty")
        ) or -20

    local strike_count = 0
    local goodwill_penalty = 0

    if not is_hostile_target then

        update_and_clean_strikes()

        local new_count =
            #fail_timestamps + 1

        fail_timestamps = {}

        for i = 1, new_count do
            table.insert(
                fail_timestamps,
                now_sec
            )
        end

        strike_count =
            #fail_timestamps

        goodwill_penalty =
            base_penalty *
            math.pow(
                2,
                strike_count - 1
            )
    end

    ----------------------------------------------------------------
    -- Goodwill / reputation penalty
    --
    -- Hostile targets receive NO additional penalty.
    ----------------------------------------------------------------

    if not is_hostile_target then

        db.actor:change_character_reputation(-20)

        if relation_registry
            and relation_registry.change_community_goodwill then

            relation_registry.change_community_goodwill(
                community,
                db.actor:id(),
                goodwill_penalty
            )
        end
    end

    ----------------------------------------------------------------
    -- NPC reaction
    ----------------------------------------------------------------

    if xr_sound
        and xr_sound.set_sound_play then

        xr_sound.set_sound_play(
            npc_id,
            "fight_enemy"
        )

    else

        local snd =
            sound_object(
                [[characters_voice\human_01\stalker\fight\enemy\enemy_1]]
            )

        if snd then
            snd:play(
                target,
                0,
                sound_object.s3d
            )
        end
    end

    ----------------------------------------------------------------
    -- Failure notification
    ----------------------------------------------------------------

    local random_index
    local string_key

    if is_hostile_target then
        -- Hostile target: use the attack-specific dialogue.
        random_index = math.random(1, 10)
        string_key =
            "st_npc_pickpocket_fail_attack_"
            .. random_index
    else
        -- Friendly/neutral target: use the normal warning dialogue.
        random_index = math.random(1, 18)
        string_key =
            "st_npc_pickpocket_fail_warn_"
            .. random_index
    end

    local raw_msg =
        game.translate_string(
            string_key
        )

    local localized_msg =
        string.gsub(
            raw_msg,
            "%%player_name%%",
            actor_name
        )

    if not is_hostile_target then
        localized_msg =
            localized_msg
            .. string.format(
                " [Penalty: %d Goodwill | Strike %d]",
                goodwill_penalty,
                strike_count
            )
    end

    if dynamic_news_helper
        and dynamic_news_helper.send_tip then

        local comm_title =
            game.translate_string(
                "st_dyn_news_comm_"
                .. community
                .. "_6"
            ) or community

        local sender_header =
            strformat(
                "%s, %s",
                npc_name,
                comm_title
            )

        local icon =
            target:character_icon()
            or "ui_ingame_monolith"

        dynamic_news_helper.send_tip(
            localized_msg,
            sender_header,
            0,
            8,
            icon,
            "danger",
            "npc"
        )

    else

        actor_menu.set_msg(
            1,
            npc_name
            .. ": "
            .. localized_msg,
            5
        )
    end
end

-------------------------------------------------------------------
-- UI Minigame Class
-------------------------------------------------------------------

class "UIPickpocketMinigame" (CUIScriptWnd)

function UIPickpocketMinigame:__init(target_npc) super()
    self.target = target_npc
    self.needle_pos = 1

    local speed =
        tonumber(get_config("needle_speed"))
        or 0.25

    if speed <= 0 then
        speed = 0.25
    end

    self.needle_dir = speed
    self.is_finished = false

    local tf =
        tonumber(get_config("time_factor"))
        or 0.2

    if tf < 0.05 then
        tf = 0.2
    end

    get_console():execute(
        "time_factor " .. tostring(tf)
    )

    self.base_cash =
        get_stash_cash_amount(target_npc)

    -- Dynamic Zone & Sweet Spot calculations
    local z_size =
        tonumber(get_config("zone_size"))
        or 30

    if z_size < 10 then
        z_size = 30
    end

    self.zone_size = math.min(80, z_size)

    self.zone_start =
        math.random(
            5,
            math.max(6, 95 - self.zone_size)
        )

    self.zone_end =
        self.zone_start + self.zone_size

    local s_size =
        tonumber(get_config("sweet_size"))
        or 10

    if s_size < 2 then
        s_size = 10
    end

    self.sweet_size =
        math.min(self.zone_size, s_size)

    local max_sweet_start =
        math.max(
            self.zone_start,
            self.zone_end - self.sweet_size
        )

    if max_sweet_start <= self.zone_start then
        self.sweet_start = self.zone_start
    else
        self.sweet_start =
            math.random(
                self.zone_start,
                max_sweet_start
            )
    end

    self.sweet_end =
        self.sweet_start + self.sweet_size

    self:InitControls()
end

function UIPickpocketMinigame:__finalize()
    get_console():execute("time_factor 1")
end

function UIPickpocketMinigame:InitControls()
    self:SetWndRect(
        Frect():set(0, 0, 1024, 768)
    )

    local box_w = 512
    local box_h = 256
    local box_x = (1024 - box_w) / 2

    -- UI Y position resolution
    local val = get_config("box_y")
    local box_y = 250

    if type(val) == "string" or type(val) == "number" then
        local num = tonumber(val)

        if num == 1 or num == 250 then
            box_y = 250
        elseif num == 2 or num == 450 then
            box_y = 450
        elseif num and num > 50 then
            box_y = num
        end
    end

    local font_small =
        GetFontLetterica16Russian
        and GetFontLetterica16Russian()
        or GetFontSmall()

    local font_bold =
        GetFontGraffiti22Russian
        and GetFontGraffiti22Russian()
        or GetFontHeader()

    self.bg_frame = CUIStatic()
    self.bg_frame:SetAutoDelete(true)

    self.bg_frame:SetWndPos(
        vector2():set(box_x, box_y)
    )

    self.bg_frame:SetWndSize(
        vector2():set(box_w, box_h)
    )

    self.bg_frame:InitTexture(
        "ui\\ui_pickpocket_bg"
    )

    self.bg_frame:SetStretchTexture(true)
    self:AttachChild(self.bg_frame)

    local function add_line(
        x_off,
        y_off,
        w,
        h,
        text,
        color,
        font
    )
        local line = CUIStatic()
        line:SetAutoDelete(true)

        line:SetWndPos(
            vector2():set(
                box_x + x_off,
                box_y + y_off
            )
        )

        line:SetWndSize(
            vector2():set(w, h)
        )

        line:TextControl():SetFont(font)
        line:TextControl():SetText(text)
        line:TextControl():SetTextColor(color)

        self:AttachChild(line)

        return line
    end

    local color_green =
        GetARGB(255, 80, 220, 100)

    local color_yellow =
        GetARGB(255, 255, 200, 0)

    local color_white =
        GetARGB(255, 255, 255, 255)

    local color_muted =
        GetARGB(255, 160, 160, 160)

    local z_start =
        math.floor(self.zone_start)

    local z_end =
        math.floor(self.zone_end)

    local s_start =
        math.floor(self.sweet_start)

    local s_end =
        math.floor(self.sweet_end)

    local mult =
        tonumber(get_config("sweet_spot_mult"))
        or 3.0

    add_line(
        138,
        65,
        200,
        30,
        string.format(
            "Zone %d%% - %d%%",
            z_start,
            z_end
        ),
        color_green,
        font_bold
    )

    add_line(
        103,
        100,
        210,
        30,
        string.format(
            "Sweet Spot %d%% - %d%%",
            s_start,
            s_end
        ),
        color_yellow,
        font_bold
    )

    add_line(
        103,
        145,
        175,
        25,
        string.format(
            "Approx reward ~ %d RUB",
            self.base_cash
        ),
        color_white,
        font_bold
    )

    add_line(
        254,
        145,
        110,
        20,
        string.format(
            "(x%.1f Sweet Spot)",
            mult
        ),
        color_yellow,
        font_small
    )

    self.progress_text =
        add_line(
            320,
            80,
            150,
            35,
            "1%",
            color_white,
            font_bold
        )

    local confirm_dik =
        mcm_key_to_dik(
            "confirm_key",
            DIK_keys.DIK_SPACE
        )

    local key_name =
        ui_mcm
        and ui_mcm.dik_to_key
        and ui_mcm.dik_to_key(confirm_dik)
        or "SPACE"

    self.prompt_text =
        add_line(
            263,
            96,
            180,
            20,
            string.format(
                "[Press %s to confirm]",
                string.upper(key_name)
            ),
            color_muted,
            font_small
        )
end

function UIPickpocketMinigame:Update()
    CUIScriptWnd.Update(self)

    if self.is_finished then
        return
    end

    self.needle_pos =
        self.needle_pos + self.needle_dir

    if self.needle_pos >= 100 then
        self.needle_pos = 100
        self.needle_dir =
            -math.abs(self.needle_dir)

    elseif self.needle_pos <= 1 then
        self.needle_pos = 1
        self.needle_dir =
            math.abs(self.needle_dir)
    end

    if self.progress_text then
        self.progress_text:TextControl():SetText(
            string.format(
                "%d%%",
                math.floor(self.needle_pos)
            )
        )
    end
end

function UIPickpocketMinigame:OnKeyboard(
    dik,
    keyboard_action
)
    CUIScriptWnd.OnKeyboard(
        self,
        dik,
        keyboard_action
    )

    local event_press =
        (ui_events and ui_events.WINDOW_KEY_PRESS)
        or 256

    if keyboard_action == event_press then
        local confirm_dik =
            mcm_key_to_dik(
                "confirm_key",
                DIK_keys.DIK_SPACE
            )

        if dik == confirm_dik
            or dik == DIK_keys.DIK_ESCAPE then

            self:TriggerStop()
            return true
        end
    end

    return true
end

function UIPickpocketMinigame:TriggerStop()
    if self.is_finished then
        return
    end

    self.is_finished = true

    get_console():execute("time_factor 1")

    CreateTimeEvent(
        "pickpocket_ui",
        "close_wnd",
        0.01,
        function()
            active_minigame = nil
            self:HideDialog()
            self:FinishMinigame()
            return true
        end
    )
end

function UIPickpocketMinigame:FinishMinigame()
    get_console():execute("time_factor 1")

    local target = self.target

    if not target then
        return
    end

    local npc_id = target:id()

    pickpocketed_npcs[npc_id] = true

    local pos = self.needle_pos

    local function play_rouble_sound()
        local snd_path =
            [[interface\items\inv_items_money_coin_2]]

        if utils_data
            and utils_data.play_2d_sound then

            utils_data.play_2d_sound(
                snd_path
            )
        else
            local snd =
                sound_object(snd_path)

            if snd then
                snd:play(
                    db.actor,
                    0,
                    sound_object.s2d
                )
            end
        end
    end

    if pos >= self.sweet_start and pos <= self.sweet_end then
    local mult = tonumber(get_config("sweet_spot_mult")) or 3.0
    local cash = math.floor(self.base_cash * mult)

    db.actor:give_money(cash)
    play_rouble_sound()

    actor_menu.set_msg(
        1,
        string.format("Stole Jackpot: %d RU!", cash),
        4
    )

    -- Chance to find an additional item
    local loot_chance =
        tonumber(get_config("loot_chance")) or 25

    if math.random(1, 100) <= loot_chance then
        local loot_section, loot_category =
            get_random_pickpocket_loot()

        if loot_section then
            alife():create(
                loot_section,
                db.actor:position(),
                db.actor:level_vertex_id(),
                db.actor:game_vertex_id(),
                db.actor:id()
            )

            actor_menu.set_msg(
                1,
                "Found something extra in their pocket!",
                4
            )
        end
    end

    elseif pos >= self.zone_start
        and pos <= self.zone_end then

        local cash = self.base_cash

        db.actor:give_money(cash)
        play_rouble_sound()

        actor_menu.set_msg(
            1,
            "Stole " .. tostring(cash) .. " RU!",
            3
        )

    else
        handle_failure(target)
    end
end

-------------------------------------------------------------------
-- Triggers & Callbacks
-------------------------------------------------------------------

local function try_pickpocket()
    local target = level.get_target_obj()

    if not target
        or not IsStalker(target)
        or not target:alive() then

        return
    end

    if not is_actor_walking() then
    actor_menu.set_msg(
        1,
        "I better do it sneakily instead...",
        2
    )
        return
    end

    ----------------------------------------------------------------
    -- Pickpocket proximity
    ----------------------------------------------------------------

    local pickpocket_distance =
        get_pickpocket_distance(target)

    if not pickpocket_distance then
        return
    end

    -- Too far away for even the proximity feedback.
    if pickpocket_distance > PICKPOCKET_FEEDBACK_DISTANCE then
        return
    end

    -- Close enough to know we're attempting it, but not close
    -- enough to actually reach the target.
    if pickpocket_distance > PICKPOCKET_DISTANCE then

        actor_menu.set_msg(
            1,
            "I'm too far away to pick their pockets...",
            2
        )

        return
    end

    if not is_behind_npc(target) then
        actor_menu.set_msg(
            1,
            "Better not stand where they can see my hands...",
            2
        )
        return
    end

    ----------------------------------------------------------------
    -- MCM hostile-faction toggle
    ----------------------------------------------------------------

    local raw_enemies =
        get_config("allow_enemies")

    local allow_enemies = false

    if raw_enemies == true
        or raw_enemies == 1
        or raw_enemies == "true"
        or raw_enemies == "1" then

        allow_enemies = true
    end

    -- If hostile pickpocketing is disabled, use the same
    -- relation check as the original working script.
    if not allow_enemies
        and is_npc_hostile(target) then

        actor_menu.set_msg(
            1,
            "Not too wise to dig around enemies' pockets...",
            2
        )

        return
    end

    local npc_id = target:id()

    if pickpocketed_npcs[npc_id] then
        actor_menu.set_msg(
            1,
            "Already searched this stalker...",
            2
        )
        return
    end

    actor_menu.set_msg(
        1,
        "Rummaging through pockets...",
        2
    )

    local ok, err = pcall(function()
        active_minigame =
            UIPickpocketMinigame(target)

        active_minigame:ShowDialog(true)
    end)

    if not ok then
        get_console():execute(
            "time_factor 1"
        )

        actor_menu.set_msg(
            1,
            "UI ERROR: " .. tostring(err),
            5
        )

        printf(
            "[PICKPOCKET UI ERROR] %s",
            tostring(err)
        )
    end
end

local function on_key_press(key)
    local trigger_key =
        mcm_key_to_dik(
            "trigger_key",
            DIK_keys.DIK_V
        )

    local confirm_key =
        mcm_key_to_dik(
            "confirm_key",
            DIK_keys.DIK_SPACE
        )

    if active_minigame then
        if key == confirm_key then
            active_minigame:TriggerStop()
        end

        return
    end

    if key == trigger_key then
        try_pickpocket()
    end
end

-------------------------------------------------------------------
-- PDA Encyclopedia Patch Integration
-------------------------------------------------------------------

local function clr(name)
    return utils_xml.get_color(name)
end

local function get_pda_status_text()
    local base_penalty =
        math.abs(
            tonumber(
                get_config("base_goodwill_penalty")
            ) or 20
        )

    local decay_sec =
        tonumber(
            get_config("fail_window_sec")
        ) or 1800

    local sweet_mult =
        tonumber(
            get_config("sweet_spot_mult")
        ) or 3.0

    local trigger_dik =
        mcm_key_to_dik(
            "trigger_key",
            DIK_keys.DIK_V
        )

    local key_name =
        ui_mcm
        and ui_mcm.dik_to_key
        and ui_mcm.dik_to_key(trigger_dik)
        or "V"

    key_name = string.upper(key_name)

    local decay_game_mins =
        math.floor(decay_sec / 60)

    local time_factor = 10

    if level and level.get_time_factor then
        time_factor =
            level.get_time_factor()
            or 10
    end

    local decay_irl_mins =
        math.floor(
            (decay_sec / time_factor) / 60
        )

    local mult_str =
        string.format(
            "x%.1f",
            sweet_mult
        )

    local c_title =
        clr("pda_white")

    local c_green =
        clr("green")

    local c_yellow =
        clr("yellow")

    local c_red =
        clr("red")

    local c_blue =
        clr("pda_blue")

    local c_note =
        clr("ui_orange")

    local c_gray =
        clr("ui_gray_1")

    local str =
        " \\n \\n"
        .. c_title
        .. "This mod will allow you to pickpocket other stalkers around the Zone who are not actively trying to rip out your spine.%c[default]"

    str = str
        .. " \\n \\n"
        .. c_title
        .. "To start pickpocketing you need to approach your target from behind, "
        .. c_blue
        .. "crouch, slow walk or hold LALT and press "
        .. key_name
        .. c_title
        .. " on the target. That will start the pickpocketing minigame where you have to match "
        .. c_title
        .. "your current position"
        .. c_title
        .. " with either the "
        .. c_green
        .. "green zone, that will give you the base payout"
        .. c_title
        .. ", or the "
        .. c_yellow
        .. "yellow, which will allow you to "
        .. mult_str
        .. " your cash.%c[default]"

    str = str
        .. " \\n \\n--------------------------------------------------"

    str = str
        .. " \\n \\n"
        .. c_title
        .. "The local factions actively share chatter regarding clumsy thieves in the Zone.%c[default]"

    str = str
        .. " \\n \\n"
        .. c_title
        .. "Every time you "
        .. c_red
        .. "fail"
        .. c_title
        .. " a pickpocket attempt, your failure streak increases, causing escalating goodwill penalties with the victim's faction. Base penalty starts at "
        .. c_title
        .. tostring(base_penalty)
        .. " lost goodwill"
        .. c_title
        .. ", which doubles with each consecutive failure in the time window.%c[default]"

    str = str
        .. " \\n \\n"
        .. c_note
        .. string.format(
            "Note: Pickpocket strikes decay by 1 every %d minutes of game time (%d minutes IRL) if no failed attempts occur.",
            decay_game_mins,
            decay_irl_mins
        )
        .. "%c[default]"

    local strikes, next_pen, time_left =
        get_tracker_info()

    str = str
        .. " \\n \\n"
        .. c_title
        .. "--- CURRENT PICKPOCKET HEAT ---%c[default]"

    if strikes == 0 then
        str = str
            .. " \\n"
            .. c_green
            .. "Status: Clean (No active strikes)%c[default]"

        str = str
            .. " \\n"
            .. c_title
            .. "Next Failure Penalty: "
            .. c_yellow
            .. tostring(next_pen)
            .. " Goodwill%c[default]"
    else
        local last_lost =
            -base_penalty
            * math.pow(2, strikes - 1)

        local status_color =
            strikes >= 3
            and c_red
            or c_yellow

        str = str
            .. " \\n"
            .. status_color
            .. string.format(
                "Status: ACTIVE HEAT (%d Strikes)",
                strikes
            )
            .. "%c[default]"

        str = str
            .. " \\n"
            .. c_title
            .. "Last Penalty Incurred: "
            .. c_red
            .. tostring(last_lost)
            .. " Goodwill%c[default]"

        str = str
            .. " \\n"
            .. c_title
            .. "Next Failure Penalty: "
            .. c_red
            .. tostring(next_pen)
            .. " Goodwill%c[default]"

        if time_left > 0 then
            local mins =
                math.floor(time_left / 60)

            local secs =
                math.floor(time_left % 60)

            str = str
                .. " \\n"
                .. c_gray
                .. string.format(
                    "Strike Decay in: %dm %ds (Game Time)",
                    mins,
                    secs
                )
                .. "%c[default]"
        end
    end

    return str
end

local patched = false

local function patch_pda_encyclopedia()
    if patched
        or not ui_pda_encyclopedia_tab then

        return
    end

    patched = true

    local base_UpdateDescr =
        ui_pda_encyclopedia_tab.UpdateDescr

    if base_UpdateDescr then
        ui_pda_encyclopedia_tab.UpdateDescr =
            function(section, str)

                local orig_text =
                    base_UpdateDescr(
                        section,
                        str
                    )

                if section ==
                    "encyclopedia__notes_eqz_pickpocket_tracker" then

                    local ok, extra =
                        pcall(
                            get_pda_status_text
                        )

                    if ok and extra then
                        return extra
                    end
                end

                return orig_text
            end
    end

    local base_UpdateName =
        ui_pda_encyclopedia_tab.UpdateName

    if base_UpdateName then
        ui_pda_encyclopedia_tab.UpdateName =
            function(section)

                local name =
                    base_UpdateName(section)

                if section ==
                    "encyclopedia__notes_eqz_pickpocket_tracker" then

                    if name == section
                        or string.find(
                            name,
                            "encyclopedia__"
                        ) then

                        name =
                            game.translate_string(
                                "encyclopedia__notes_eqz_pickpocket_tracker"
                            )
                    end

                    local strikes =
                        #fail_timestamps

                    local status_str =
                        strikes > 0
                        and string.format(
                            " [%d Strikes]",
                            strikes
                        )
                        or " [Clean]"

                    return name .. status_str
                end

                return name
            end
    end
end

-------------------------------------------------------------------
-- Auto-Unlock & State Management
-------------------------------------------------------------------

local function unlock_guide_note()
    if db.actor then
        db.actor:give_info_portion(
            "encyclopedia__notes_eqz_pickpocket_tracker"
        )
    end
end

local function save_state(m_data)
    m_data.pickpocket_searched =
        pickpocketed_npcs

    m_data.pickpocket_fails =
        fail_timestamps
end

local function load_state(m_data)
    pickpocketed_npcs =
        m_data.pickpocket_searched
        or {}

    fail_timestamps =
        m_data.pickpocket_fails
        or {}
end

function on_game_start()
    RegisterScriptCallback(
        "on_key_press",
        on_key_press
    )

    RegisterScriptCallback(
        "save_state",
        save_state
    )

    RegisterScriptCallback(
        "load_state",
        load_state
    )

    RegisterScriptCallback(
        "on_game_load",
        unlock_guide_note
    )

    patch_pda_encyclopedia()
end